+        if (s == 0) {
+            const int requested = g_fish_web_mode.load(std::memory_order_acquire);
+            mode = requested == 0 ? PSXRecompV4::PAD_MODE_DIGITAL
+                 : requested == 1 ? PSXRecompV4::PAD_MODE_ANALOG
+                 : PSXRecompV4::PAD_MODE_HYBRID;
+        }
+#endif
@@ -2471,0 +2510,27 @@
+#if defined(PSX_WEB)
+        if (s == 0) {
+            uint32_t packed = g_fish_web_axes.load(std::memory_order_acquire);
+            uint8_t web_axes[4] = {
+                (uint8_t)(packed & 0xFFu),
+                (uint8_t)((packed >> 8) & 0xFFu),
+                (uint8_t)((packed >> 16) & 0xFFu),
+                (uint8_t)((packed >> 24) & 0xFFu)
+            };
+            const bool web_stick_live = (web_axes[0] != 0x80 ||
+                                         web_axes[1] != 0x80 ||
+                                         web_axes[2] != 0x80 ||
+                                         web_axes[3] != 0x80);
+            if (mode == PSXRecompV4::PAD_MODE_HYBRID && web_stick_live) {
+                p.hybrid_analog = true;
+                eff_analog = 1;
+            }
+            if (eff_analog) {
+                /* Browser Gamepad API analog axes are authoritative for P1.
+                 * Keep SDL keyboard stick fallback if the web values are centred. */
+                for (int i = 0; i < 4; ++i) {
+                    if (g_fish_web_gamepad_connected.load(std::memory_order_acquire) ||
+                        web_axes[i] != 0x80) st[i] = web_axes[i];
+                }
+            }
+        }
+#endif
