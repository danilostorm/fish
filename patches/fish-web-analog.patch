--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -291,0 +292,22 @@
+/* PS1 DualShock analogue bytes (LX, LY, RX, RY). Shared atomically across
+ * the browser main thread and Emscripten guest worker. Default centred.
+ * 0: digital; 1: analogue DualShock; 2: hybrid mode. */
+static std::atomic<uint32_t> g_fish_web_axes{0x80808080u};
+static std::atomic<int> g_fish_web_gamepad_connected{0};
+static std::atomic<int> g_fish_web_mode{1};
+extern "C" EMSCRIPTEN_KEEPALIVE void psx_web_set_pad_axes(uint32_t packed, int gamepad_connected) {
+    g_fish_web_axes.store(packed, std::memory_order_release);
+    g_fish_web_gamepad_connected.store(gamepad_connected ? 1 : 0,
+                                     std::memory_order_release);
+}
+extern "C" EMSCRIPTEN_KEEPALIVE void psx_web_set_pad_mode(int mode) {
+    if (mode >= 0 && mode <= 2)
+        g_fish_web_mode.store(mode, std::memory_order_release);
+}
+extern "C" EMSCRIPTEN_KEEPALIVE uint32_t psx_web_get_pad_axes(void) {
+    return g_fish_web_axes.load(std::memory_order_acquire);
+}
+extern "C" EMSCRIPTEN_KEEPALIVE int psx_web_get_pad_analog(void) {
+    return sio_get_pad_analog(0);
+}
+
@@ -2113 +2135,5 @@
-        sio_set_pad_analog(s, pad_mode_boot_analog(p.mode), 0x80, 0x80, 0x80, 0x80);
+        int boot_analog = pad_mode_boot_analog(p.mode);
+#if defined(PSX_WEB)
+        if (s == 0) boot_analog = g_fish_web_mode.load(std::memory_order_acquire) != 0;
+#endif
+        sio_set_pad_analog(s, boot_analog, 0x80, 0x80, 0x80, 0x80);
@@ -2118 +2144,5 @@
