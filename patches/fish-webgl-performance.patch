+struct FishWebRenderTimer {
+    Uint64 start;
+    FishWebRenderTimer() : start(SDL_GetPerformanceCounter()) {}
+    ~FishWebRenderTimer() {
+        Uint64 end=SDL_GetPerformanceCounter();
+        Uint64 freq=SDL_GetPerformanceFrequency();
+        if (end>=start && freq) {
+            g_fish_perf_render_us.fetch_add(
+                ((end-start)*1000000u)/freq, std::memory_order_relaxed);
+            g_fish_perf_render_frames.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+};
