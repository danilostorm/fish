+/* Scan out a whole PS1 frame in one pass. Calling gpu_display_pixel_argb
+ * individually from another translation unit blocks compiler inlining and
+ * repeats screen-kind and scan-address work tens of thousands of times.
+ * The raw 5->8 conversion below is bit-identical to gpu_rgb555_to_rgb888.
+ * Custom color LUTs and 24-bit packed FMV retain the original conversion. */
+void gpu_display_to_argb_fast(const GpuDisplayInfo* di, uint32_t* dst,
+                              uint32_t pitch_px, uint32_t width, uint32_t height) {
+    if (!di || !dst) return;
+    screen_lut_ensure();
+    if (di->depth24 || s_screen_lut) {
+        for (uint32_t y = 0; y < height; ++y)
+            for (uint32_t x = 0; x < width; ++x)
+                dst[y*pitch_px+x] = gpu_display_pixel_argb(di,x,y);
+        return;
+    }
+    const uint16_t* base = gpu_get_vram();
+    const uint32_t x0 = di->display_x & 1023u;
+    const uint32_t y0 = di->display_y & 511u;
+    for (uint32_t y=0; y<height; ++y) {
+        const uint16_t* row = base + (((y0+y)&511u) * 1024u);
+        uint32_t* out = dst+y*pitch_px;
+        for (uint32_t x=0; x<width; ++x) {
+            uint32_t v = row[(x0+x)&1023u];
+            out[x] = 0xFF000000u | ((v&31u)<<19u) |
+                     (((v>>5u)&31u)<<11u) | (((v>>10u)&31u)<<3u);
+        }
+    }
+}
